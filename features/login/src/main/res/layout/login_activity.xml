<?xml version="1.0" encoding="utf-8"?>
<!--
  Host shell layout for LoginActivity.

  The Activity itself owns essentially no widgets; the whole screen is
  composed by `assemble {}` (see LoginActivity.kt) attaching three Pages
  into the `assemblyContainer` LinearLayout below.

  ScrollView outermost — keeps the page usable when the IME pushes the
  inputs up on short screens.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/assemblyContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</ScrollView>
