<?xml version="1.0" encoding="utf-8"?>
<!--
  Single tag chip used by `RelatedTagsCarousel`'s internal RecyclerView.
  Plain `TextView` is enough: the click listener is attached programmatically
  by `RelatedTagsCarousel.TagViewHolder`, and the click handler resolves the
  Shell VM via `view.findPageContext()`. No `android:onClick`, no inline
  callback wiring.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    android:background="?android:attr/selectableItemBackground"
    android:minHeight="28dp"
    android:paddingHorizontal="10dp"
    android:paddingVertical="4dp"
    android:textColor="?android:attr/colorAccent"
    android:textSize="12sp" />
