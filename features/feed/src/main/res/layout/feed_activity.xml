<?xml version="1.0" encoding="utf-8"?>
<!--
    Multi-slot host layout. Each Page in FeedActivity picks the slot
    it wants via `at(R.id.feed_header_slot)` / `feed_body_slot` /
    `feed_footer_slot`. This is what `MountSpec.at(id)` resolves
    against — no default container on the assemble() call.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <FrameLayout
        android:id="@+id/feed_header_slot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:id="@+id/feed_body_slot"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <FrameLayout
        android:id="@+id/feed_footer_slot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
