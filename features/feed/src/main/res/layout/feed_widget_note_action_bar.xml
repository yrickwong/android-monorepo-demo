<?xml version="1.0" encoding="utf-8"?>
<!--
  Internal layout for `NoteActionBar`. Inflated with `attachToParent = true`,
  so this <merge> needs the NoteActionBar (a LinearLayout) as its parent at
  inflate time. We deliberately do NOT mention the FeedShellViewModel here
  in any form — the widget reaches the VM via `view.requirePageContext()`,
  see widget/NoteActionBar.kt.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout"
    tools:orientation="horizontal">

    <Button
        android:id="@+id/action_like"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="32dp"
        android:paddingHorizontal="12dp"
        android:text="@string/feed_action_like"
        android:textAllCaps="false"
        android:textSize="12sp" />

    <Button
        android:id="@+id/action_share"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:minHeight="32dp"
        android:paddingHorizontal="12dp"
        android:text="@string/feed_action_share"
        android:textAllCaps="false"
        android:textSize="12sp" />
</merge>
