<?xml version="1.0" encoding="utf-8"?>
<!-- MessagesTopBarPage 的 root view：关闭（右）+ 居中标题 + 发起会话（左） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/mainframe_space_lg">

    <TextView
        android:id="@+id/mainframe_messages_btn_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:contentDescription="@string/mainframe_cd_close"
        android:padding="6dp"
        android:text="✕"
        android:textColor="@color/mainframe_text_primary"
        android:textSize="22sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/mainframe_title_messages"
        android:textColor="@color/mainframe_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:contentDescription="@string/mainframe_cd_new_chat"
        android:padding="6dp"
        android:text="✎"
        android:textColor="@color/mainframe_text_primary"
        android:textSize="22sp" />
</FrameLayout>
