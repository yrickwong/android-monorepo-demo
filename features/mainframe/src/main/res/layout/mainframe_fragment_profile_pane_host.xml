<?xml version="1.0" encoding="utf-8"?>
<!--
    ProfilePaneHostFragment 的容器布局。

    槽位：
      slot_content   ← ProfileContentPage (MultiTypeListPage<ProfileRow>, StaggeredGrid)
      slot_top_bar   ← ProfileTopBarPage  (ViewPage, 浮在内容之上的关闭+操作栏)

    顶部栏浮在 RV 之上（z-order 由 XML 顺序决定，后声明的视图在上层）。
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mainframe_pane_profile_bg">

    <FrameLayout
        android:id="@+id/mainframe_profile_slot_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 状态栏 inset 占位 -->
    <View
        android:id="@+id/mainframe_profile_status_inset"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/mainframe_profile_slot_top_bar"
        android:layout_width="0dp"
        android:layout_height="44dp"
        app:layout_constraintTop_toBottomOf="@id/mainframe_profile_status_inset"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
