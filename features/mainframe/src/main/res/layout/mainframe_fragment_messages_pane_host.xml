<?xml version="1.0" encoding="utf-8"?>
<!--
    MessagesPaneHostFragment 的容器布局。

    槽位：
      slot_top_bar ← MessagesTopBarPage (ViewPage, 关闭+标题+发起会话)
      slot_list    ← MessagesListPage   (MultiTypeListPage<MessageRow>, LinearLayoutManager)
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mainframe_pane_messages_bg">

    <!-- 状态栏 inset 占位 -->
    <View
        android:id="@+id/mainframe_messages_status_inset"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/mainframe_messages_slot_top_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/mainframe_top_bar_height"
        app:layout_constraintTop_toBottomOf="@id/mainframe_messages_status_inset"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/mainframe_messages_divider"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:background="@color/mainframe_divider"
        app:layout_constraintTop_toBottomOf="@id/mainframe_messages_slot_top_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/mainframe_messages_slot_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/mainframe_messages_divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
