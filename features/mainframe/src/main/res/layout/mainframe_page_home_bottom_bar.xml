<?xml version="1.0" encoding="utf-8"?>
<!--
    HomeBottomBarPage 的 root view：原 fragment_home_pane.xml 中底部 LinearLayout 的内容。

    业务自包含：左侧编辑按钮 / 中间搜索胶囊 / 右侧语音按钮
    与框架解耦：通过 HomePaneActions.addScrollDirectionListener 订阅 Feed 滚动方向，
    实现"上滑收起 / 下滑展开"动画。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- 左侧：圆形编辑按钮 -->
    <FrameLayout
        android:id="@+id/mainframe_home_btn_compose"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/mainframe_bg_floating_round_btn"
        android:contentDescription="@string/mainframe_cd_compose"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="✎"
            android:textColor="@color/mainframe_text_primary"
            android:textSize="20sp" />
    </FrameLayout>

    <!-- 中间：胶囊搜索条 -->
    <LinearLayout
        android:id="@+id/mainframe_home_search_pill"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="@dimen/mainframe_space_sm"
        android:layout_weight="1"
        android:background="@drawable/mainframe_bg_input_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/mainframe_search_placeholder"
            android:textColor="@color/mainframe_text_secondary"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- 右侧：圆形语音按钮 -->
    <FrameLayout
        android:id="@+id/mainframe_home_btn_voice"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/mainframe_bg_floating_round_btn"
        android:contentDescription="@string/mainframe_cd_voice"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="🎤"
            android:textSize="18sp" />
    </FrameLayout>
</LinearLayout>
