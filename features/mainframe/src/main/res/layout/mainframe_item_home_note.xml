<?xml version="1.0" encoding="utf-8"?>
<!-- Home Feed / Profile Notes 通用笔记卡片 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="3dp"
    android:layout_marginBottom="6dp"
    android:background="@android:color/white"
    android:orientation="vertical">

    <!-- 封面 -->
    <FrameLayout
        android:id="@+id/mainframe_note_cover_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:id="@+id/mainframe_note_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/mainframe_bg_image_placeholder" />

        <TextView
            android:id="@+id/mainframe_note_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="6dp"
            android:background="#80000000"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            android:visibility="gone"
            tools:ignore="UnusedAttribute" />
    </FrameLayout>

    <TextView
        android:id="@+id/mainframe_note_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginHorizontal="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/mainframe_text_primary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginHorizontal="6dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/mainframe_note_avatar"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="@drawable/mainframe_bg_avatar_placeholder" />

        <TextView
            android:id="@+id/mainframe_note_author"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/mainframe_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="♡"
            android:textColor="@color/mainframe_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/mainframe_note_likes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:textColor="@color/mainframe_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
